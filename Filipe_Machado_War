#include <string.h>
#define MAX_NOME 30
#define MAX_COR 10
#define NUM_TERRITORIOS 5

struct Territorio {
    char nome[MAX_NOME];
    char corDoExercito[MAX_COR];
    int numeroDeTropas;
};
void limparBuffer() {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}
int main() {
    struct Territorio mapa[NUM_TERRITORIOS];
    printf("=== Cadastro de Territorios ===\n");
    for (int i = 0; i < NUM_TERRITORIOS; i++) {
        printf("\n--- Territorio %d ---\n", i + 1);
        printf("Digite o nome do territorio: ");
        fgets(mapa[i].nome, MAX_NOME, stdin);
        mapa[i].nome[strcspn(mapa[i].nome, "\n")] = 0;
        printf("Digite a cor do exercito: ");
        fgets(mapa[i].corDoExercito, MAX_COR, stdin);
        mapa[i].corDoExercito[strcspn(mapa[i].corDoExercito, "\n")] = 0;
        printf("Digite o numero de tropas: ");
        scanf("%d", &mapa[i].numeroDeTropas);
        limparBuffer();
    }
    printf("\n\n=== Estado Atual do Mapa ===\n");
    printf("--------------------------------------------------\n");
    printf("%-20s | %-15s | %s\n", "Territorio", "Cor do Exercito", "Tropas");
    printf("--------------------------------------------------\n");
    for (int i = 0; i < NUM_TERRITORIOS; i++) {
        printf("%-20s | %-15s | %d\n", mapa[i].nome, mapa[i].corDoExercito, mapa[i].numeroDeTropas);
    }
    printf("--------------------------------------------------\n");
    return 0;
}
